#!name = 哔哩哔哩去广告 · 开屏版 v5
#!desc = 由请求脚本返回完整的空开屏响应，拦截广告视频素材并过滤首页推广。
#!homepage = https://github.com/zhuchen458/bilibiliads-loon
#!system = iOS
#!date = 2026-11-06

[Rule]
# 仅拦截抓包确认的开屏广告视频路径，不封整个 CDN。
URL-REGEX,^https://upos-sz-static\.bilivideo\.com(?::443)?/ssaxcode/[^/?]{2}/[^/?]{2}/[^/?]+\.mp4(?:[?]|$),REJECT

[Rewrite]
# 保留活动接口的账户状态，只清空开屏活动列表。
^https:\/\/app\.(?:bilibili\.com|biliapi\.net)(?::443)?\/x\/v2\/splash\/event\/list2(?:\?|$) response-body-json-jq 'if type != "object" then . elif .code != 0 or (.data | type) != "object" then . elif (.data.event_list | type) == "array" then .data.event_list = [] else . end'

# 保留普通推荐，移除明确标记的广告。
^https:\/\/app\.(?:bilibili\.com|biliapi\.net)(?::443)?\/x\/v2\/feed\/index(?:\?|$) response-body-json-jq 'def marked_ad: .is_ad as $flag | ($flag == true or $flag == 1 or $flag == "1") or (.ad_info | type == "object" and length > 0) or (.card_type == "cm_v2" and (.card_goto | IN("ad_web_s", "ad_av", "ad_web_gif", "ad_player", "ad_inline_3d", "ad_inline_eggs"))) or (.card_type == "cm_double_v9" and .card_goto == "ad_inline_av"); if type != "object" then . elif .code != 0 or (.data | type) != "object" then . elif (.data.items | type) != "array" then . else .data.items |= map( if type != "object" then . elif marked_ad then empty elif .card_type == "banner_v8" and .card_goto == "banner" and (.banner_item | type == "array" and length > 0) then .banner_item |= map(select(if type == "object" then .type != "ad" else true end)) | select(.banner_item | length > 0) else . end ) end'

[Script]
http-request ^https:\/\/app\.(?:bilibili\.com|biliapi\.net)(?::443)?\/x\/v2\/splash\/(?:list|show|brand\/list)(?:\?|$) script-path=https://raw.githubusercontent.com/zhuchen458/bilibiliads-loon/main/splash-v5.js,tag=BilibiliSplashV5,requires-body=false,timeout=5,enable=true

[MitM]
hostname = app.bilibili.com, app.biliapi.net, upos-sz-static.bilivideo.com
